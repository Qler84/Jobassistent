# Kopiere diese Datei zu ".env" und trage eigene Werte ein (lokale Entwicklung).
# Auf Render werden dieselben Variablen im Dashboard gesetzt (siehe render.yaml).

# Connection-String einer Postgres-Datenbank, z.B. von Neon.tech oder Supabase (kostenlos, dauerhaft).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Beliebiger langer Zufallsstring - Basis fuer JWT-Signierung UND Verschluesselung
# abgelegter Zugangsdaten. Erzeugen z.B. mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string

# Ein einziger Anthropic-API-Key, den der Betreiber bereitstellt - gilt fuer
# ALLE Nutzer (Cover-Letter-Generierung, PDF-Import, Job-Alert-Import).
# Siehe console.anthropic.com. Nutzer hinterlegen NUR ihre eigenen SMTP/IMAP-
# Zugangsdaten selbst, keinen eigenen Claude-Key.
ANTHROPIC_API_KEY=sk-ant-...

# Ein einziger Brevo-API-Key (app.brevo.com, kostenlos: 300 Mails/Tag) fuer
# den E-Mail-Versand aller Nutzer ueber HTTPS statt rohem SMTP (Render
# blockiert auf dem kostenlosen Tier ausgehende SMTP-Ports). Jeder Nutzer
# verifiziert seine eigene Absenderadresse einmalig in den Einstellungen.
BREVO_API_KEY=xkeysib-...

# Kommagetrennt, ohne abschliessenden Slash
CORS_ORIGINS=http://localhost:5173
